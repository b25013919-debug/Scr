local function skyRainbowStep()
    if S.Sky ~= 4 then return end
    local t = tick() * 0.12
    local at = Lighting:FindFirstChild("CA_Atmos")
    if at then
        at.Color = Color3.fromHSV(t % 1, 0.7, 1)
        at.Decay = Color3.fromHSV((t + 0.3) % 1, 0.7, 0.9)
    end
    Lighting.Ambient = Color3.fromHSV(t % 1, 0.7, 1):Lerp(Color3.new(0, 0, 0), 0.55)
    Lighting.OutdoorAmbient = Lighting.Ambient
end

