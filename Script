local function hopServer(minPlayers)
    local ok2, res = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok2 or not res or not res.data then return false end
    local best
    for _, sv in ipairs(res.data) do
        if sv.id ~= game.JobId and sv.playing and sv.maxPlayers and sv.playing >= minPlayers and sv.playing < sv.maxPlayers then
            if not best or sv.playing > best.playing then best = sv end
        end
    end
    if best then
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, best.id, lp)
        return true
    end
    return false
end

