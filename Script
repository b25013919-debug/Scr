local function auraStep()
    local c, r = lp.Character, root()
    if not (c and r) then return end
    local col = S.AuraRainbow and Color3.fromHSV((tick() * 0.4) % 1, 0.9, 1) or ACC
    local e = r:FindFirstChild("CA_Aura")
    if not e then
        e = Instance.new("ParticleEmitter")
        e.Name = "CA_Aura"
        e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        e.Rate = 45
        e.Lifetime = NumberRange.new(0.9, 1.5)
        e.Speed = NumberRange.new(0.5, 2.5)
