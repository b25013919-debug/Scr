local muzzleCache, muzzleT
local function muzzlePos()
    local c = cam()
    if not c then return nil end
    if S.ThirdPerson and lp.Character then
        local hd = lp.Character:FindFirstChild("Head")
        if hd then return hd.Position + hd.CFrame.LookVector * 1.5 - Vector3.new(0, 0.3, 0) end
    end
    if muzzleCache and muzzleCache.Parent and muzzleT and tick() - muzzleT < 1.5 then return muzzleCache.Position end
    muzzleT = tick()
    muzzleCache = nil
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = string.lower(d.Name)
            if n:find("muzzle") or n:find("barrel") or n:find("flash") then
                muzzleCache = d
                return d.Position
            end
        end
    end
    return (c.CFrame * CFrame.new(0.6, -0.5, -2)).Position
end
local function spawnTracer()
    local c = cam()
    if not c then return end
    local from = muzzlePos()
    if not from then return end
    local to
    if S.Silent and silentTarget and silentTarget.Parent then
        to = silentTarget.Position
    else
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { lp.Character, c }
        local res = workspace:Raycast(c.CFrame.Position, c.CFrame.LookVector * 800, params)
        to = res and res.Position or (c.CFrame.Position + c.CFrame.LookVector * 800)
    end
    local dist = (to - from).Magnitude
    if dist < 1 then return end
    local col = S.TracerRainbow and Color3.fromHSV((tick() * 0.6) % 1, 1, 1) or ACC
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Material, p.Color = Enum.Material.Neon, col
    p.Size = Vector3.new(S.TracerWidth / 20, S.TracerWidth / 20, dist)
    p.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -dist / 2)
    p.Parent = workspace
    tw(p, S.TracerTime / 10, { Transparency = 1 })
    task.delay(S.TracerTime / 10 + 0.1, function() p:Destroy() end)
end
local function fireStep()
    if S.Tracers and firing and tick() - lastTracer > 0.07 then
        lastTracer = tick()
        spawnTracer()
    end
    if not S.AutoFire then return end
    local part = S.Silent and silentTarget or nil
    if not part then
        local _, pt = getTarget(S.AimFOV, S.AimPart, true)
        part = pt
    end
    if part and (tick() - lastFire) * 1000 >= S.FireDelay then
        lastFire = tick()
        click()
        if S.Tracers then spawnTracer() end
    end
end

-- ---- ESP (drawn every frame after the camera, so it does not lag behind)
local espObjs, visCache, lastVis = {}, {}, 0
local fovCircle
local function newDraw(kind, props)
    local d = DrawingLib.new(kind)
    for k, v in pairs(props) do d[k] = v end
    return d
end
local function getESP(p)
    local o = espObjs[p]
    if not o then
        o = {
            box = newDraw("Square", { Thickness = 1.5, Filled = false, Visible = false, Transparency = 1 }),
            name = newDraw("Text", { Size = 13, Center = true, Outline = true, Visible = false }),
            dist = newDraw("Text", { Size = 12, Center = true, Outline = true, Visible = false }),
            hpBg = newDraw("Square", { Filled = true, Visible = false, Color = Color3.new(0, 0, 0), Transparency = 0.6 }),
            hp = newDraw("Square", { Filled = true, Visible = false, Transparency = 1 }),
            snap = newDraw("Line", { Thickness = 1, Visible = false, Transparency = 1 }),
        }
        espObjs[p] = o
    end
    return o
end
local function hideESP(o)
    for _, d in pairs(o) do d.Visible = false end
end
local function removeESP(p)
    local o = espObjs[p]
    if o then
        for _, d in pairs(o) do pcall(function() d:Remove() end) end
        espObjs[p] = nil
    end
end
local function clearAllESP()
    for p in pairs(espObjs) do removeESP(p) end
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        local h = ch and ch:FindFirstChild("CA_HL")
        if h then h:Destroy() end
    end
end
local function espColor(p)
    if S.VisColor then return visCache[p] and GRN or RED end
    return (p.Team and p.TeamColor.Color) or Color3.new(1, 1, 1)
end
local function espStep()
    local c = cam()
    if not c then return end
    local now = tick()
    local updVis = now - lastVis > 0.1
    if updVis then lastVis = now end
    local vp = c.ViewportSize
    local myR = root()
    local doDraw = DrawingLib and DrawingLib.new
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local ch = p.Character
            local h = ch and ch:FindFirstChildOfClass("Humanoid")
            local head = ch and ch:FindFirstChild("Head")
            local pr = ch and ch:FindFirstChild("HumanoidRootPart")
            local show = S.ESP and h and head and pr and h.Health > 0
            if show and not S.ESPTeam and not isEnemy(p) then show = false end
            local dist = (show and myR) and (pr.Position - myR.Position).Magnitude or 0
            if show and dist > S.MaxDist then show = false end
            if show and updVis and S.VisColor then visCache[p] = visible(head, p) end
            local hl = ch and ch:FindFirstChild("CA_HL")
            if show and S.Chams then
                if not hl then
                    hl = new("Highlight", { Name = "CA_HL", FillTransparency = 0.55, OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, ch)
                end
                local col = espColor(p)
                hl.FillColor, hl.OutlineColor = col, col
            elseif hl then
                hl:Destroy()
            end
            local o = doDraw and getESP(p) or nil
            if o then
                if not show then
                    hideESP(o)
                else
                    local top, onT = c:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.25, 0))
                    local bot, onB = c:WorldToViewportPoint(pr.Position - Vector3.new(0, 3, 0))
                    if top.Z <= 0 or bot.Z <= 0 then
                        hideESP(o)
                    else
                        local height = math.max(bot.Y - top.Y, 4)
                        local width = height * 0.55
                        local x, y = top.X - width / 2, top.Y
                        local col = espColor(p)
                        o.box.Visible = S.Box
                        o.box.Position, o.box.Size, o.box.Color = Vector2.new(x, y), Vector2.new(width, height), col
                        o.name.Visible = S.ESPName
                        o.name.Text = p.Name
                        o.name.Position, o.name.Color = Vector2.new(top.X, y - 16), Color3.new(1, 1, 1)
                        o.dist.Visible = S.ESPDist
                        o.dist.Text = math.floor(dist) .. " st"
                        o.dist.Position, o.dist.Color = Vector2.new(top.X, y + height + 2), Color3.fromRGB(210, 210, 220)
                        local frac = math.clamp(h.Health / math.max(h.MaxHealth, 1), 0, 1)
                        o.hpBg.Visible = S.ESPHealth
                        o.hpBg.Position, o.hpBg.Size = Vector2.new(x - 6, y - 1), Vector2.new(4, height + 2)
                        o.hp.Visible = S.ESPHealth
                        o.hp.Position, o.hp.Size = Vector2.new(x - 5, y + height * (1 - frac)), Vector2.new(2, height * frac)
                        o.hp.Color = Color3.fromHSV(frac * 0.33, 0.9, 1)
                        o.snap.Visible = S.Snap
                        o.snap.From, o.snap.To, o.snap.Color = Vector2.new(vp.X / 2, vp.Y), Vector2.new(top.X, bot.Y), col
                    end
                end
            end
        end
    end
    for p, o in pairs(espObjs) do
        if not p.Parent then removeESP(p) end
    end
end
local function fovStep()
    if not (DrawingLib and DrawingLib.new) then return end
    if not fovCircle then
        fovCircle = DrawingLib.new("Circle")
        fovCircle.Thickness = 1.2
        fovCircle.NumSides = 64
        fovCircle.Filled = false
    end
    local c = cam()
    if not c then return end
    local vp = c.ViewportSize
    fovCircle.Visible = S.ShowFOV and (S.Aim or S.Silent)
    fovCircle.Position = Vector2.new(vp.X / 2, vp.Y / 2)
    fovCircle.Radius = S.Aim and S.AimFOV or S.SilentFOV
    fovCircle.Color = ACC
end

-- ---- third person
local function thirdPersonStep()
    if not S.ThirdPerson then return end
    local c = cam()
    local r = root()
    if not (c and r) then return end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { lp.Character, c }
    local hit = workspace:Raycast(c.CFrame.Position, -c.CFrame.LookVector * S.TPDist, params)
    local dist = hit and math.max(hit.Distance - 0.4, 0.5) or S.TPDist
    c.CFrame = c.CFrame * CFrame.new(1.2, 0.4, dist)
    for _, d in ipairs(lp.Character:GetDescendants()) do
        if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
    end
end

-- ---- viewmodel (arms and weapon colors)
local vmOrig = setmetatable({}, { __mode = "k" })
local function isArmPart(part)
    local n = string.lower(part.Name)
    return n:find("arm") or n:find("hand") or n:find("sleeve") or n:find("glove") or n:find("finger") or n:find("wrist")
end
local function applyVM()
    local c = cam()
    if not c then return end
    local col = Color3.fromHSV((tick() * 0.35) % 1, 0.9, 1)
    for _, m in ipairs(c:GetChildren()) do
        if m:IsA("Model") or m:IsA("Folder") then
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") then
                    local arm = isArmPart(d)
                    local mode = arm and S.ArmMode or S.WeapMode
                    if not vmOrig[d] then vmOrig[d] = { d.Color, d.Transparency, d.Material } end
                    local o = vmOrig[d]
                    if S.ThirdPerson then
                        d.Transparency = 1
                    elseif mode == 1 then
                        d.Color, d.Transparency, d.Material = o[1], o[2], o[3]
                    elseif mode == 2 then
                        d.Color, d.Material, d.Transparency = col, Enum.Material.Neon, o[2]
                    elseif mode == 3 then
                        d.Color, d.Material, d.Transparency = ACC, Enum.Material.Neon, o[2]
                    elseif mode == 4 then
                        d.Transparency = math.max(o[2], S.ArmTrans / 100)
                    else
                        d.Color, d.Material, d.Transparency = col, Enum.Material.ForceField, o[2]
                    end
                end
            end
        end
    end
end
local function restoreVM()
    for d, o in pairs(vmOrig) do
        pcall(function()
            if d.Parent then d.Color, d.Transparency, d.Material = o[1], o[2], o[3] end
        end)
    end
    vmOrig = setmetatable({}, { __mode = "k" })
end

