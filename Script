local function applySky()
    local pr = SKY_PRESETS[S.Sky]
    if not pr then
        clearSky()
        return
    end
    local sky = ensure("Sky", "CA_Sky")
    sky.StarCount = pr.stars or 0
    sky.CelestialBodiesShown = true
    local at = ensure("Atmosphere", "CA_Atmos")
    at.Density, at.Offset, at.Glare, at.Haze = pr.dens, pr.off or 0, pr.glare or 0, pr.haze
    at.Color, at.Decay = pr.atmos, pr.decay
    local bl = ensure("BloomEffect", "CA_Bloom")
    bl.Intensity, bl.Size, bl.Threshold = pr.bloom, 28, 0.9
    local cc = ensure("ColorCorrectionEffect", "CA_CC")
    cc.TintColor, cc.Saturation = pr.tint or Color3.new(1, 1, 1), 0.25
    Lighting.ClockTime = pr.clock
    Lighting.Ambient, Lighting.OutdoorAmbient = pr.amb, pr.amb
